  ];

  const viewMoreDataset = [
    { id: 9, name: 'Rolex Submariner', price: 750000, image: 'https://images.unsplash.com/photo-1547996160-81dfa63595aa?q=80&w=800&auto=format&fit=crop', categories: ['all', 'men', 'brands'], brand: 'ROLEX', offer: false },
    { id: 10, name: 'Casio Vintage Digital', price: 5995, originalPrice: 8560, offerText: 'Save 30%', image: 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=80&w=800&auto=format&fit=crop', categories: ['all', 'women', 'brands'], brand: 'CASIO', offer: true },
    { id: 11, name: 'Omega Speedmaster', price: 420000, image: 'https://images.unsplash.com/photo-1509048191080-d2984bad6ae5?q=80&w=800&auto=format&fit=crop', categories: ['all', 'men', 'brands'], brand: 'OMEGA', offer: false },
    { id: 12, name: 'Fossil Smart Gen 6', price: 24995, image: 'https://images.unsplash.com/photo-1579586337278-3befd40fd17a?q=80&w=800&auto=format&fit=crop', categories: ['all', 'smart', 'brands'], brand: 'FOSSIL', offer: false }
  ];

  let masterWatches = [...allWatchesDataset];
  let currentFilter = 'all';
  let currentBrandFilter = null;
  let searchKeyword = '';

  let cart = [];
  let wishlist = [];

  document.addEventListener("DOMContentLoaded", () => {
    renderWatches();
  });

  function renderWatches() {
    const container = document.getElementById("watchContainer");
    container.innerHTML = "";

    let filteredList = masterWatches.filter(watch => {
      // If a search keyword exists, let search logic handle everything
      if (searchKeyword !== '') {
        // 1. Check intent for complete collection names
        if (searchKeyword.includes('men collection') || searchKeyword === 'men') {
          return watch.categories.includes('men');
        }
        if (searchKeyword.includes('women collection') || searchKeyword === 'women') {
          return watch.categories.includes('women');
        }
        if (searchKeyword.includes('smart collection') || searchKeyword === 'smart') {
          return watch.categories.includes('smart');
        }
        if (searchKeyword.includes('offer')) {
          return watch.offer === true;
        }

        if (watch.brand.toLowerCase() === searchKeyword) {
          return true;
        }

        return watch.name.toLowerCase().includes(searchKeyword);
      }
       
      if (currentBrandFilter) {
        return watch.brand.toUpperCase() === currentBrandFilter.toUpperCase();
      }
      if (currentFilter === 'all') return true;
      if (currentFilter === 'offers') return watch.offer === true;
      return watch.categories.includes(currentFilter);
    });

    if (filteredList.length === 0) {
      container.innerHTML = `<div class="col-12 text-center my-5"><p class="text-muted fs-5">No watches found matching criteria.</p></div>`;
      return;
    }

    filteredList.forEach(watch => {
      const isWishlisted = wishlist.some(item => item.id === watch.id);
      const wishlistClass = isWishlisted ? "wishlist-btn active" : "wishlist-btn";
      const wishlistIcon = isWishlisted ? "ri-heart-fill" : "ri-heart-line";

      let priceDisplayHtml = `<p class="price">₹${watch.price.toLocaleString('en-IN')}</p>`;
      let badgeHtml = '';
      
      if(watch.offer && watch.originalPrice) {
        badgeHtml = `<div class="offer-badge"><i class="bi bi-tag-fill me-1"></i>${watch.offerText}</div>`;
        priceDisplayHtml = `
          <p class="price">
            <span class="old-price">₹${watch.originalPrice.toLocaleString('en-IN')}</span>
            <span>₹${watch.price.toLocaleString('en-IN')}</span>
          </p>
        `;
      }

      const cardHtml = `
        <div class="col-lg-3 col-md-6">
          <div class="card product-card shadow-sm h-100">
            <img src="${watch.image}" class="card-img-top" alt="${watch.name}">
            <div class="${wishlistClass}" onclick="toggleWishlistState(${watch.id})">
              <i class="${wishlistIcon}"></i>
            </div>
            <div class="card-body text-center">
              ${badgeHtml}
              <h4>${watch.name}</h4>
              ${priceDisplayHtml}
              <button class="btn btn-dark me-2" onclick="addToCart('${watch.name}', ${watch.price}, ${watch.id})">
                Add To Cart
              </button>
              <button class="btn btn-warning" onclick="openPayment(${watch.id})">
                Buy Now
              </button>
            </div>
          </div>
        </div>
      `;
      container.innerHTML += cardHtml;
    });
  }

  function filterCategory(category, event) {
    if(event) event.preventDefault();
    currentFilter = category;
    currentBrandFilter = null;
    searchKeyword = '';
    document.getElementById("watchSearch").value = '';
    
    const headings = {
      all: 'ALL WATCHES COLLECTION',
      men: 'MEN\'S PREMIUM COLLECTION',
      women: 'WOMEN\'S LUXURY COLLECTION',
      smart: 'SMART EXCLUSIVES',
      brands: 'BRAND PARTNERS',
      offers: 'SPECIAL PROMOTIONAL OFFERS'
    };
    document.getElementById("currentSectionTitle").innerText = headings[category] || 'COLLECTION';
    
    if (category === 'all') {
      document.getElementById("viewMoreContainer").style.display = "block";
    } else {
      document.getElementById("viewMoreContainer").style.display = "none";
    }

    renderWatches();
  }

  function filterBrand(brandName) {
    currentBrandFilter = brandName;
    currentFilter = null;
    searchKeyword = '';
    document.getElementById("watchSearch").value = '';
    document.getElementById("currentSectionTitle").innerText = brandName.toUpperCase() + " SHOWCASE";
    document.getElementById("viewMoreContainer").style.display = "none";
    renderWatches();
  }

  function searchWatches() {
    searchKeyword = document.getElementById("watchSearch").value.trim().toLowerCase();
    
    // Dynamically adjust titles if a structured term is processed
    if (searchKeyword !== "") {
      document.getElementById("currentSectionTitle").innerText = "SEARCH RESULTS FOR: " + searchKeyword.toUpperCase();
      document.getElementById("viewMoreContainer").style.display = "none";
    } else {
      document.getElementById("currentSectionTitle").innerText = "NEW ARRIVALS";
      document.getElementById("viewMoreContainer").style.display = "block";
    }
    
    renderWatches();
  }

  function loadMoreWatches() {
    const uniqueMore = viewMoreDataset.filter(d => !masterWatches.some(m => m.id === d.id));
    masterWatches = [...masterWatches, ...uniqueMore];
    document.getElementById("viewMoreContainer").style.display = "none";
    renderWatches();
    alert("4 Premium items appended successfully!");
  }

  function addToCart(name, price, id) {
    const watchItem = masterWatches.find(w => w.id === id) || allWatchesDataset.find(w => w.id === id);
    cart.push(watchItem);
    updateCounters();
    renderCartModal();
    alert(name + " added to cart!");
  }

  function toggleWishlistState(id) {
    const watchItem = masterWatches.find(w => w.id === id) || allWatchesDataset.find(w => w.id === id);
    const index = wishlist.findIndex(item => item.id === id);

    if (index !== -1) {
      wishlist.splice(index, 1);
      alert(watchItem.name + " removed from wishlist!");
    } else {
      wishlist.push(watchItem);
      alert(watchItem.name + " added to wishlist!");
    }
    updateCounters();
    renderWatches();
    renderWishlistModal();
  }

  function updateCounters() {
    document.getElementById("cart-count").innerText = cart.length;
    document.getElementById("wishlist-count").innerText = wishlist.length;
  }

  function renderWishlistModal() {
    const body = document.getElementById("wishlistModalBody");
    if(wishlist.length === 0) {
      body.innerHTML = `<div class="text-center py-4 text-muted">Your Wishlist is empty.</div>`;
      return;
    }
    let html = `<div class="list-group">`;
    wishlist.forEach(item => {
      html += `
        <div class="list-group-item d-flex align-items-center justify-content-between p-3">
          <div class="d-flex align-items-center">
            <img src="${item.image}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" class="me-3">
            <div>
              <h6 class="mb-0 fw-bold">${item.name}</h6>
              <small class="text-warning">₹${item.price.toLocaleString('en-IN')}</small>
            </div>
          </div>
          <button class="btn btn-sm btn-danger rounded-circle" onclick="toggleWishlistState(${item.id})">
            <i class="ri-delete-bin-line"></i>
          </button>
        </div>
      `;
    });
    html += `</div>`;
    body.innerHTML = html;
  }

  function renderCartModal() {
    const body = document.getElementById("cartModalBody");
    if(cart.length === 0) {
      body.innerHTML = `<div class="text-center py-4 text-muted">Your Cart is empty.</div>`;
      return;
    }
    let html = `<div class="list-group mb-3">`;
    let total = 0;
    cart.forEach((item, index) => {
      total += item.price;
      html += `
        <div class="list-group-item d-flex align-items-center justify-content-between p-3">
          <div class="d-flex align-items-center">
            <img src="${item.image}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" class="me-3">
            <div>
              <h6 class="mb-0 fw-bold">${item.name}</h6>
              <small class="text-warning">₹${item.price.toLocaleString('en-IN')}</small>
            </div>
          </div>
          <button class="btn btn-sm btn-outline-danger" onclick="removeFromCart(${index})">
            Remove
          </button>
        </div>
      `;
    });
    html += `</div>`;
    html += `
      <div class="d-flex justify-content-between align-items-center fw-bold fs-5 p-2 bg-light rounded mb-3">
        <span>Subtotal:</span>
        <span class="text-warning">₹${total.toLocaleString('en-IN')}</span>
      </div>
      <button class="btn btn-dark w-100 py-2 rounded-pill" data-bs-dismiss="modal" onclick="openPayment(null, true, ${total})">
        Proceed To Checkout
      </button>
    `;
    body.innerHTML = html;
  }

  function removeFromCart(index) {
    cart.splice(index, 1);
    updateCounters();
    renderCartModal();
  }

  function showSignup(){
    document.getElementById("loginForm").style.display = "none";
    document.getElementById("signupForm").style.display = "block";
  }

  function showLogin(){
    document.getElementById("signupForm").style.display = "none";
    document.getElementById("loginForm").style.display = "block";
  }

  const loginBtn = document.querySelector("#loginForm button");

  loginBtn.addEventListener("click", function () {
    const email = document.querySelector('#loginForm input[type="email"]').value.trim();
    const password = document.querySelector('#loginForm input[type="password"]').value.trim();
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (email === "") { alert("Please enter email"); return; }
    if (!emailPattern.test(email)) { alert("Please enter valid email"); return; }
    if (password === "") { alert("Please enter password"); return; }
    if (password.length < 6) { alert("Password must be at least 6 characters"); return; }

    alert("Login Successful");
  });

  const signupBtn = document.querySelector("#signupForm button");

  signupBtn.addEventListener("click", function () {
    const name = document.querySelector('#signupForm input[type="text"]').value.trim();
    const email = document.querySelector('#signupForm input[type="email"]').value.trim();
    const password = document.querySelector('#signupForm input[type="password"]').value.trim();
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (name === "") { alert("Please enter full name"); return; }
    if (email === "") { alert("Please enter email"); return; }
    if (!emailPattern.test(email)) { alert("Please enter valid email"); return; }
    if (password === "") { alert("Please create password"); return; }
    if (password.length < 6) { alert("Password must be at least 6 characters"); return; }

    alert("Account Created Successfully");
  });

  function openPayment(id, isBatchCart = false, customTotal = 0){
    const form = document.getElementById("checkoutForm");
    form.classList.remove("was-validated");
    form.reset();

    const oldPriceEl = document.getElementById("productOldPrice");
    const offerBadgeEl = document.getElementById("checkoutOfferBadge");
    const discountRowEl = document.getElementById("discountRow");
    const discountAmountEl = document.getElementById("discountAmount");

    if (isBatchCart) {
      document.getElementById("productName").innerText = "Cart Summary Pack";
      document.getElementById("productPrice").innerText = "₹" + customTotal.toLocaleString('en-IN');
      document.getElementById("totalPrice").innerText = "₹" + customTotal.toLocaleString('en-IN');
      document.getElementById("productImage").src = "https://images.unsplash.com/photo-1522312346375-d1a52e2b99b3?q=80&w=800";
      
      oldPriceEl.classList.add("d-none");
      offerBadgeEl.innerHTML = "";
      discountRowEl.classList.add("d-none");
    } else {
      const watch = masterWatches.find(w => w.id === id) || allWatchesDataset.find(w => w.id === id);
      
      document.getElementById("productName").innerText = watch.name;
      document.getElementById("productPrice").innerText = "₹" + watch.price.toLocaleString('en-IN');
      document.getElementById("totalPrice").innerText = "₹" + watch.price.toLocaleString('en-IN');
      document.getElementById("productImage").src = watch.image;

      if (watch.offer && watch.originalPrice) {
        oldPriceEl.innerText = "₹" + watch.originalPrice.toLocaleString('en-IN');
        oldPriceEl.classList.remove("d-none");
        
        offerBadgeEl.innerHTML = `<span class="badge bg-danger"><i class="bi bi-gift-fill me-1"></i>Promo Applied: ${watch.offerText}</span>`;
        
        let savings = watch.originalPrice - watch.price;
        discountAmountEl.innerText = "- ₹" + savings.toLocaleString('en-IN');
        discountRowEl.classList.remove("d-none");
      } else {
        oldPriceEl.classList.add("d-none");
        offerBadgeEl.innerHTML = "";
        discountRowEl.classList.add("d-none");
      }
    }

    let paymentModal = new bootstrap.Modal(document.getElementById('paymentModal'));
    paymentModal.show();
  }

  function validatePaymentForm() {
    const form = document.getElementById("checkoutForm");
    form.classList.add("was-validated");

    if (!form.checkValidity()) {
      const firstInvalid = form.querySelector(":invalid");
      if(firstInvalid) {
        alert("Please fix the empty or invalid fields highlighted in red before paying.");
        firstInvalid.focus();
      }
      return;
    }

    paymentSuccess();
  }

  function paymentSuccess(){
    alert("Payment Successful! Your order has been placed securely.");
    const modalElement = document.getElementById('paymentModal');
    const modalInstance = bootstrap.Modal.getInstance(modalElement);
    if(modalInstance) {
      modalInstance.hide();
    }
  }

</script>

