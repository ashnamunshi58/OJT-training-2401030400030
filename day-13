    <div class="modal-content">

      <div class="modal-header bg-dark text-white">
        <h3 class="modal-title">Secure Checkout</h3>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body p-4 bg-light">
        <form id="checkoutForm" class="needs-validation" novalidate onsubmit="event.preventDefault();">
          <div class="row g-4">

            <div class="col-lg-4">

              <div class="bg-white rounded-4 shadow-sm p-4 h-100">
               <img id="productImage"
                  src=""
                  class="img-fluid rounded-4 mb-4"
                  style="height:300px;width:100%;object-fit:cover;">

                <h3 id="productName"></h3>
                <div class="d-flex align-items-center mt-3">
                  <span id="productOldPrice" class="old-price d-none"></span>
                  <h4 class="price m-0" id="productPrice"></h4>
                </div>
                <div id="checkoutOfferBadge" class="mt-2"></div>

                <hr>

                <div class="d-flex justify-content-between">
                  <span>Delivery</span>
                  <span class="text-success">FREE</span>
                </div>

                <div class="d-flex justify-content-between mt-2">
                  <span>GST</span>
                  <span>Included</span>
                </div>

                <div id="discountRow" class="d-flex justify-content-between mt-2 text-danger d-none">
                  <span>Promotional Discount</span>
                  <span id="discountAmount"></span>
                </div>

                <hr>

                <div class="d-flex justify-content-between fw-bold fs-5">
                  <span>Total</span>
                  <span id="totalPrice" class="text-warning"></span>
                </div>
              </div>
            </div>

            <div class="col-lg-8">
              <div class="bg-white rounded-4 shadow-sm p-4">

                <h4 class="fw-bold mb-4">Contact Details</h4>

                <div class="row g-3">

                  <div class="col-md-6">
                    <label class="form-label">Full Name</label>
                    <input type="text" id="payName" class="form-control" placeholder="Enter Full Name" required>
                    <div class="invalid-feedback">Please enter your full name.</div>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label">Email Address</label>
                    <input type="email" id="payEmail" class="form-control" placeholder="Enter Email" required>
                    <div class="invalid-feedback">Please enter a valid email address.</div>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label">Phone Number</label>
                    <input type="tel" id="payPhone" class="form-control" placeholder="9876543210" pattern="[0-9]{10}" required>
                    <div class="invalid-feedback">Please enter a valid 10-digit phone number.</div>
                  </div>

                </div>

                <h4 class="fw-bold mt-5 mb-4">Delivery Details</h4>
                <div class="row g-3">

                  <div class="col-12">
                    <label class="form-label">Street Address</label>
                    <input type="text" id="payAddress" class="form-control" placeholder="House No, Street Name" required>
                    <div class="invalid-feedback">Street address is required.</div>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">City</label>
                    <input type="text" id="payCity" class="form-control" placeholder="Ahmedabad" required>
                    <div class="invalid-feedback">Please enter your city.</div>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">State</label>
                    <input type="text" id="payState" class="form-control" placeholder="Gujarat" required>
                    <div class="invalid-feedback">Please enter your state.</div>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">PIN Code</label>
                    <input type="text" id="payPin" class="form-control" placeholder="380001" pattern="[0-9]{6}" required>
                    <div class="invalid-feedback">Please enter a valid 6-digit PIN code.</div>
                  </div>

                </div>

                <h4 class="fw-bold mt-5 mb-4">Payment Options</h4>
                <div class="row g-3">

                  <div class="col-md-4">
                    <label class="payment-option w-100">
                      <input type="radio" name="payment" checked>
                      <i class="bi bi-google"></i>
                      Google Pay
                    </label>
                  </div>

                  <div class="col-md-4">
                    <label class="payment-option w-100">
                      <input type="radio" name="payment">
                      <i class="bi bi-wallet2"></i>
                      Paytm
                    </label>
                  </div>

                  <div class="col-md-4">
                    <label class="payment-option w-100">
                      <input type="radio" name="payment">
                      <i class="bi bi-cash"></i>
                      Cash On Delivery
                    </label>
                  </div>
                </div>

                <button class="btn btn-dark w-100 py-3 rounded-pill mt-5 fw-bold"
                  onclick="validatePaymentForm()">
                  <i class="bi bi-shield-lock-fill me-2"></i>
                  Confirm & Pay Securely
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

