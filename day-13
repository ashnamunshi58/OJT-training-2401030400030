<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Luxury Watches</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Remix Icon -->
  <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet">

  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>

    body{
      font-family:'Poppins',sans-serif;
      background:#f5f5f5;
    }

    .top-bar{
      background:#111;
    }

    .logo{
      font-family:'Cinzel',serif;
      color:#d4af37;
      letter-spacing:3px;
      font-size:35px;
    }

    .top-link{
      color:#fff;
      text-decoration:none;
      transition:0.3s;
    }

    .top-link:hover{
      color:#d4af37;
    }

    .icon{
      font-size:24px;
      cursor:pointer;
      transition:0.3s;
      color:#fff;
    }

    .icon:hover{
      color:#d4af37;
    }

    .navbar-nav .nav-link{
      font-family:'Cinzel',serif;
      color:#111;
      font-size:17px;
      margin-right:15px;
    }

    .navbar-nav .nav-link:hover{
      color:#c79a3b;
    }

    .search-box{
      position:relative;
    }

    .search-box input{
      border-radius:30px;
      padding-right:45px;
      width:250px;
    }

    .search-box i{
      position:absolute;
      right:18px;
      top:50%;
      transform:translateY(-50%);
    }

    .slider img{
      height:500px;
      object-fit:cover;
    }

    .section-title{
      font-family:'Cinzel',serif;
      background:#000d11;
      color:#fff;
      padding:12px;
      border-radius:5px;
    }

    .section-subtitle{
      color:#c79a3b;
      font-size:20px;
    }

    .brands{
      background:#111;
    }

    .brand-name{
      color:#fff;
      font-family:'Cinzel',serif;
      transition:0.3s;
      cursor:pointer;
    }

    .brand-name:hover{
      color:#d4af37;
      transform:scale(1.1);
    }

    .product-card{
      border:none;
      transition:0.3s;
      border-radius:12px;
      overflow:hidden;
      position:relative;
    }

    .product-card:hover{
      transform:translateY(-10px);
    }

    .product-card img{
      height:250px;
      object-fit:cover;
    }

    .price{
      color:#c79a3b;
      font-size:22px;
      font-weight:600;
    }

    .old-price {
      text-decoration: line-through;
      color: #888;
      font-size: 16px;
      margin-right: 8px;
    }

    .offer-badge {
      background: #dc3545;
      color: #fff;
      font-size: 12px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 4px;
      display: inline-block;
      margin-bottom: 5px;
    }

    .btn-dark:hover{
      background:#c79a3b;
      border-color:#c79a3b;
    }

    .cart-icon{
      position:relative;
    }

    #cart-count,
    #wishlist-count{
      position:absolute;
      top:-8px;
      right:-10px;
      background:#d4af37;
      color:#fff;
      width:20px;
      height:20px;
      border-radius:50%;
      font-size:12px;
      display:flex;
      align-items:center;
      justify-content:center;
      font-weight:bold;
    }

    .wishlist-btn{
      position:absolute;
      top:12px;
      right:12px;
      width:42px;
      height:42px;
      border-radius:50%;
      background:#fff;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:22px;
      color:#111;
      cursor:pointer;
      transition:0.3s;
      z-index:10;
      box-shadow:0 4px 10px rgba(0,0,0,0.2);
    }

    .wishlist-btn:hover{
      transform:scale(1.1);
    }

    .wishlist-btn.active{
      background:#d4af37;
      color:#fff;
    }

    .modal-content{
      border-radius:20px;
      border:none;
    }

    .input-group-text{
      background:#111;
      color:#d4af37;
      border:none;
    }

    .form-control{
      border-left:none;
    }

    .form-control:focus{
      box-shadow:none;
      border-color:#d4af37;
    }

    .payment-option{
      border:2px solid #ddd;
      border-radius:15px;
      padding:15px;
      cursor:pointer;
      transition:0.3s;
    }

    .payment-option:hover{
      border-color:#d4af37;
      background:#fffaf0;
    }

    .payment-option input{
      margin-right:10px;
    }

  </style>
</head>

<body>
