<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Luxury Watches</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet">

  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    body{
      font-family:'Poppins',sans-serif;
      background:#f5f5f5;
    }

    .top-bar{
      background:#111;
    }

    .logo{
      font-family:'Cinzel',serif;
      color:#d4af37;
      letter-spacing:3px;
      font-size:35px;
    }

    .top-link{
      color:#fff;
      text-decoration:none;
      transition:0.3s;
    }

    .top-link:hover{
      color:#d4af37;
    }

    .icon{
      font-size:24px;
      cursor:pointer;
      transition:0.3s;
      color:#fff;
    }

    .icon:hover{
      color:#d4af37;
    }

    .navbar-nav .nav-link{
      font-family:'Cinzel',serif;
      color:#111;
      font-size:17px;
      margin-right:15px;
    }

    .navbar-nav .nav-link:hover{
      color:#c79a3b;
    }

    .search-box{
      position:relative;
      margin-left:auto; /* Adjusted for better responsiveness */
      width: 250px;
    }

    .search-box input{
      border-radius:30px;
      padding-right:45px;
    }

    .search-box i{
      position:absolute;
      right:18px;
      top:50%;
      transform:translateY(-50%);
      color: #666;
    }

    .slider img{
      height:500px;
      object-fit:cover;
    }

    .section-title{
      font-family:'Cinzel',serif;
      background:#000d11;
      color:#fff;
      padding:12px;
      border-radius:5px;
      display: inline-block;
    }

    .section-subtitle{
      color:#c79a3b;
      font-size:20px;
    }

    .brands{
      background:#111;
    }

    .brand-name{
      color:#fff;
      font-family:'Cinzel',serif;
      transition:0.3s;
      cursor:pointer;
      margin: 0;
    }

    .brand-name:hover{
      color:#d4af37;
      transform:scale(1.1);
    }

    .product-card{
      border:none;
      transition:0.3s;
      border-radius:12px;
      overflow:hidden;
    }

    .product-card:hover{
      transform:translateY(-10px);
    }

    .product-card img{
      height:250px;
      object-fit:cover;
    }

    .price{
      color:#c79a3b;
      font-size:22px;
      font-weight:600;
    }

    .btn-dark:hover{
      background:#c79a3b;
      border-color:#c79a3b;
    }

    .cart-icon{
      position:relative;
    }

    #cart-count{
      position:absolute;
      top:-8px;
      right:-10px;
      background:#d4af37;
      color:#fff;
      width:20px;
      height:20px;
      border-radius:50%;
      font-size:12px;
      display:flex;
      align-items:center;
      justify-content:center;
      font-weight:bold;
    }

    /* Modal Input Styling */
    .input-group-text {
      background-color: transparent;
      border-right: none;
      color: #555;
    }
    .modal .form-control {
      border-left: none;
    }
    .modal .form-control:focus {
      box-shadow: none;
      border-color: #dee2e6;
    }
    .input-group:focus-within .input-group-text {
      border-color: #dee2e6;
      color: #d4af37;
    }

    /* Footer Styling */
    .footer-heading {
      font-family: 'Cinzel', serif;
      color: #d4af37;
    }
    .hover-gold:hover {
      color: #d4af37 !important;
    }
  </style>
</head>

<body>

  <div class="top-bar py-3">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-4 d-flex gap-4">
          <a href="#about-section" class="top-link">
            <i class="ri-map-pin-line"></i> Stores
          </a>
          <a href="#about-section" class="top-link">
            <i class="ri-information-line"></i> About Us
          </a>
        </div>

        <div class="col-md-4 text-center">
          <h2 class="logo m-0">Luxury Watches</h2>
        </div>

        <div class="col-md-4 d-flex justify-content-end gap-4">
          <i class="ri-user-line icon" data-bs-toggle="modal" data-bs-target="#authModal" title="Account"></i>
          <i class="ri-heart-line icon" title="Wishlist"></i>
          <div class="cart-icon">
            <i class="ri-shopping-bag-line icon" title="Cart"></i>
            <span id="cart-count">0</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <nav class="navbar navbar-expand-lg bg-light shadow-sm sticky-top">
    <div class="container">
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarMenu">
        <ul class="navbar-nav mx-auto">
          <li class="nav-item"><a class="nav-link" href="#">All Watches</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Men</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Women</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Smart</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Brands</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Offers</a></li>
        </ul>

        <div class="search-box mt-3 mt-lg-0">
          <input type="text" class="form-control" placeholder="Search watches...">
          <i class="ri-search-line"></i>
        </div>
      </div>
    </div>
  </nav>

  <div id="watchSlider" class="carousel slide slider" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img src="https://i.pinimg.com/736x/1b/20/75/1b20752a3e8b29d1e20190d598f956c4.jpg" class="d-block w-100" alt="Luxury Watch">
      </div>
      <div class="carousel-item">
        <img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?q=80&w=1200" class="d-block w-100" alt="Omega Classic">
      </div>
      <div class="carousel-item">
        <img src="https://images.unsplash.com/photo-1546868871-7041f2a55e12?q=80&w=1200" class="d-block w-100" alt="Smart Watch">
      </div>
    </div>
  </div>

  <div class="modal fade" id="authModal">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content p-4 border-0 shadow">

        <div class="modal-header border-0 pb-0">
          <h4 class="modal-title font-weight-bold mx-auto" style="font-family: 'Cinzel', serif;">Welcome</h4>
          <button class="btn-close m-0 position-absolute end-0 me-3" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <div id="loginForm">
            <div class="input-group mb-3">
              <span class="input-group-text"><i class="ri-mail-line"></i></span>
              <input type="email" class="form-control py-2" placeholder="Enter Email">
            </div>

            <div class="input-group mb-3">
              <span class="input-group-text"><i class="ri-lock-line"></i></span>
              <input type="password" class="form-control py-2" placeholder="Enter Password">
            </div>

            <div class="text-end mb-3">
              <a href="#" class="text-muted small text-decoration-none">Forgot Password?</a>
            </div>

            <button class="btn btn-dark w-100 py-2 fw-bold">Login</button>

            <p class="text-center mt-4 mb-0 text-muted">
              Don't have an account?
              <span class="text-warning fw-bold text-decoration-underline ms-1" role="button" onclick="showSignup()">
                Create Account
              </span>
            </p>
          </div>

          <div id="signupForm" style="display:none;">
            <div class="input-group mb-3">
              <span class="input-group-text"><i class="ri-user-line"></i></span>
              <input type="text" class="form-control py-2" placeholder="Full Name">
            </div>

            <div class="input-group mb-3">
              <span class="input-group-text"><i class="ri-mail-line"></i></span>
              <input type="email" class="form-control py-2" placeholder="Enter Email">
            </div>

            <div class="input-group mb-3">
              <span class="input-group-text"><i class="ri-lock-line"></i></span>
              <input type="password" class="form-control py-2" placeholder="Create Password">
            </div>

            <button class="btn btn-dark w-100 py-2 fw-bold">
              Create Account
            </button>

            <p class="text-center mt-4 mb-0 text-muted">
              Already have an account?
              <span class="text-warning fw-bold text-decoration-underline ms-1" role="button" onclick="showLogin()">
                Login
              </span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="py-5 text-center">
    <div class="container">
      <h1 class="section-title px-4">NEW ARRIVALS</h1>
      <p class="section-subtitle mt-3">Premium watches for modern lifestyle</p>
    </div>
  </section>

  <section class="brands py-4">
    <div class="container">
      <div class="row text-center g-4 align-items-center">
        <div class="col-md-2 col-6"><h2 class="brand-name">ROLEX</h2></div>
        <div class="col-md-2 col-6"><h2 class="brand-name">OMEGA</h2></div>
        <div class="col-md-2 col-6"><h2 class="brand-name">FOSSIL</h2></div>
        <div class="col-md-2 col-6"><h2 class="brand-name">TITAN</h2></div>
        <div class="col-md-2 col-6"><h2 class="brand-name">CASIO</h2></div>
        <div class="col-md-2 col-6"><h2 class="brand-name">TISSOT</h2></div>
      </div>
    </div>
  </section>

  <section class="py-5">
    <div class="container">
      <div class="row g-4">

        <div class="col-lg-3 col-md-6">
          <div class="card product-card shadow-sm h-100">
            <img src="https://images.unsplash.com/photo-1546868871-7041f2a55e12?q=80&w=800" class="card-img-top">
            <div class="card-body text-center d-flex flex-column">
              <h4>Titan Smart Pro</h4>
              <p class="price">₹18,999</p>
              <div class="mt-auto">
                <button class="btn btn-dark me-1 mb-2" onclick="addToCart('Titan Smart Pro',18999)">Add To Cart</button>
                <button class="btn btn-warning mb-2" onclick="buyNow('Titan Smart Pro',18999)">Buy Now</button>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="card product-card shadow-sm h-100">
            <img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?q=80&w=800" class="card-img-top">
            <div class="card-body text-center d-flex flex-column">
              <h4>Omega Classic</h4>
              <p class="price">₹38,000</p>
              <div class="mt-auto">
                <button class="btn btn-dark me-1 mb-2" onclick="addToCart('Omega Classic',38000)">Add To Cart</button>
                <button class="btn btn-warning mb-2" onclick="buyNow('Omega Classic',38000)">Buy Now</button>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="card product-card shadow-sm h-100">
            <img src="https://images.unsplash.com/photo-1542496658-e33a6d0d50f6?q=80&w=800" class="card-img-top">
            <div class="card-body text-center d-flex flex-column">
              <h4>Fossil Watch</h4>
              <p class="price">₹18,000</p>
              <div class="mt-auto">
                <button class="btn btn-dark me-1 mb-2" onclick="addToCart('Fossil Watch',18000)">Add To Cart</button>
                <button class="btn btn-warning mb-2" onclick="buyNow('Fossil Watch',18000)">Buy Now</button>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="card product-card shadow-sm h-100">
            <img src="https://images.unsplash.com/photo-1522312346375-d1a52e2b99b3?