<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Festiva.in — Celebrate Every Moment</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<style>
:root{
  --saffron:#FF6200;--saffron2:#FF8C42;--saffron-pale:#FFF4EC;
  --gold:#F5A623;--gold2:#FFD166;
  --teal:#0A7E8C;--teal2:#12B5C4;
  --rose:#C1292E;--plum:#4A0E2E;
  --ink:#16100A;--ink2:#2D1E10;--ink3:#5C3D1E;
  --warm:#A0836A;--cream:#FDFAF6;--white:#FFFFFF;
  --border:rgba(22,16,10,.09);--border2:rgba(22,16,10,.16);
  --sh-card:0 2px 24px rgba(22,16,10,.08);
  --sh-lift:0 12px 48px rgba(22,16,10,.14);
  --r:16px;--r2:24px;--r3:12px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Outfit',sans-serif;background:var(--cream);color:var(--ink);overflow-x:hidden}
img{display:block;width:100%;object-fit:cover}
a{text-decoration:none;color:inherit}
button{font-family:'Outfit',sans-serif;cursor:pointer;border:none}
.serif{font-family:'Cormorant Garamond',serif}

/* ── SCROLLBAR ── */
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--cream)}
::-webkit-scrollbar-thumb{background:var(--saffron);border-radius:3px}

/* ── NAV ── */
#nav{position:fixed;top:0;left:0;right:0;z-index:900;height:66px;display:flex;align-items:center;padding:0 4%;background:rgba(253,250,246,.93);backdrop-filter:blur(14px);border-bottom:1px solid var(--border);transition:box-shadow .3s}
#nav.scrolled{box-shadow:0 4px 28px rgba(22,16,10,.08)}
.nav-logo{display:flex;align-items:center;gap:9px}
.logo-mark{width:34px;height:34px;background:var(--saffron);border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;font-weight:700;font-size:19px;color:#fff;letter-spacing:-1px}
.logo-text{font-family:'Cormorant Garamond',serif;font-weight:700;font-size:22px;color:var(--ink)}
.logo-text span{color:var(--saffron)}
.nav-links{display:flex;align-items:center;gap:32px;list-style:none;margin-left:auto}
.nav-links a{font-size:14px;font-weight:500;color:var(--warm);transition:color .2s}
.nav-links a:hover{color:var(--saffron)}
.nav-cta{display:flex;gap:10px;margin-left:28px}
.btn{display:inline-flex;align-items:center;gap:7px;padding:9px 20px;border-radius:100px;font-size:14px;font-weight:600;transition:all .2s;white-space:nowrap;cursor:pointer;border:none;font-family:'Outfit',sans-serif}
.btn-ghost{background:transparent;border:1.5px solid var(--border2);color:var(--ink)}
.btn-ghost:hover{border-color:var(--saffron);color:var(--saffron)}
.btn-primary{background:var(--saffron);color:#fff}
.btn-primary:hover{background:#d95300;transform:translateY(-1px);box-shadow:0 6px 20px rgba(255,98,0,.32)}
.btn-gold{background:var(--gold);color:var(--ink2);font-weight:700}
.btn-gold:hover{background:#e0951f;transform:translateY(-1px)}
.hamburger{display:none;background:none;border:none;padding:5px;flex-direction:column;gap:5px;cursor:pointer}
.hamburger span{display:block;width:22px;height:2px;background:var(--ink);transition:all .3s;border-radius:2px}
.mob-nav{display:none;position:fixed;top:66px;left:0;right:0;background:#fff;border-bottom:1px solid var(--border);z-index:899;padding:16px 5%;flex-direction:column;gap:12px}
.mob-nav.open{display:flex}
.mob-nav a{padding:10px 0;border-bottom:1px solid var(--border);font-weight:500;font-size:15px}

/* ── HERO ── */
.hero{min-height:100vh;padding-top:66px;position:relative;overflow:hidden;background:var(--ink)}
.hero-bg{position:absolute;inset:0}
.hero-bg img{width:100%;height:100%;object-fit:cover;opacity:.45;filter:saturate(1.3)}
.hero-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,rgba(22,16,10,.35) 0%,rgba(22,16,10,.6) 60%,rgba(22,16,10,.9) 100%)}
.hero-inner{position:relative;z-index:2;max-width:1280px;margin:0 auto;padding:80px 4% 60px;display:grid;grid-template-columns:1fr 420px;gap:60px;align-items:center;min-height:calc(100vh - 66px)}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);border-radius:100px;padding:6px 14px 6px 8px;font-size:12px;font-weight:600;color:#fff;letter-spacing:.04em;margin-bottom:20px}
.badge-dot{width:7px;height:7px;border-radius:50%;background:var(--gold2);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.5)}}
.hero-title{font-family:'Cormorant Garamond',serif;font-size:clamp(44px,6vw,76px);font-weight:700;line-height:1.05;color:#fff;letter-spacing:-.02em;margin-bottom:18px}
.hero-title em{font-style:italic;color:var(--gold2);display:block}
.hero-sub{font-size:17px;color:rgba(255,255,255,.72);line-height:1.7;margin-bottom:32px;max-width:480px}
.hero-btns{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.hero-stats{display:flex;gap:36px;margin-top:48px;padding-top:32px;border-top:1px solid rgba(255,255,255,.15)}
.hero-stat-n{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:700;color:#fff;display:block}
.hero-stat-l{font-size:12px;color:rgba(255,255,255,.55);letter-spacing:.04em;text-transform:uppercase}
/* hero right stack */
.hero-stack{display:flex;flex-direction:column;gap:14px}
.h-card{border-radius:20px;overflow:hidden;position:relative;cursor:pointer;flex-shrink:0}
.h-card img{height:100%;object-fit:cover;transition:transform .5s}
.h-card:hover img{transform:scale(1.04)}
.h-card-big{height:260px}
.h-card-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.h-card-sm{height:160px}
.h-card-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(22,16,10,.8) 0%,transparent 55%)}
.h-card-body{position:absolute;bottom:0;left:0;right:0;padding:14px 16px;color:#fff}
.h-card-tag{display:inline-block;background:var(--saffron);color:#fff;font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:3px 9px;border-radius:5px;margin-bottom:5px}
.h-card-name{font-family:'Cormorant Garamond',serif;font-size:16px;font-weight:600;line-height:1.2}
.h-card-loc{font-size:11px;opacity:.75;margin-top:2px}

/* ── SEARCH ── */
.search-wrap{padding:0 4% 56px;max-width:1280px;margin:0 auto}
.search-box{background:#fff;border-radius:22px;box-shadow:0 10px 52px rgba(22,16,10,.13);padding:22px 26px;display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap}
.sf{flex:1;min-width:150px}
.sf label{display:block;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--warm);margin-bottom:5px}
.sf input,.sf select{width:100%;border:none;outline:none;font-family:'Outfit',sans-serif;font-size:14px;color:var(--ink);background:transparent;padding:3px 0;border-bottom:1.5px solid var(--border);transition:border-color .2s;appearance:none}
.sf input:focus,.sf select:focus{border-bottom-color:var(--saffron)}
.sdiv{width:1px;background:var(--border);align-self:stretch;min-height:40px}
.search-btn{background:var(--saffron);color:#fff;border:none;border-radius:14px;padding:13px 26px;font-size:14px;font-weight:700;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:8px;white-space:nowrap;font-family:'Outfit',sans-serif}
.search-btn:hover{background:#d95300;transform:translateY(-1px);box-shadow:0 6px 20px rgba(255,98,0,.3)}

/* ── SECTIONS ── */
.section{padding:70px 4%}
.si{max-width:1280px;margin:0 auto}
.slabel{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--saffron);margin-bottom:8px}
.stitle{font-family:'Cormorant Garamond',serif;font-size:clamp(28px,3vw,42px);font-weight:700;letter-spacing:-.02em;color:var(--ink);line-height:1.15}
.ssub{font-size:15px;color:var(--warm);margin-top:8px;max-width:460px;line-height:1.6}
.shead{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:36px;flex-wrap:wrap}

/* ── CATEGORIES ── */
.cats-section{background:var(--cream)}
.cat-scroll{display:flex;gap:12px;overflow-x:auto;padding-bottom:6px;scrollbar-width:none}
.cat-scroll::-webkit-scrollbar{display:none}
.cat-pill{display:flex;align-items:center;gap:8px;background:#fff;border:1.5px solid var(--border);border-radius:100px;padding:10px 18px;cursor:pointer;transition:all .2s;white-space:nowrap;flex-shrink:0}
.cat-pill:hover,.cat-pill.active{background:var(--saffron);border-color:var(--saffron);color:#fff}
.cat-pill.active .cp-icon,.cat-pill:hover .cp-icon{filter:brightness(10)}
.cp-icon{font-size:18px;transition:filter .2s}
.cp-name{font-size:13px;font-weight:600;color:var(--ink);transition:color .2s}
.cat-pill:hover .cp-name,.cat-pill.active .cp-name{color:#fff}
.cp-count{font-size:11px;color:var(--warm);margin-left:2px;transition:color .2s}
.cat-pill:hover .cp-count,.cat-pill.active .cp-count{color:rgba(255,255,255,.75)}

/* ── EVENTS GRID ── */
.events-section{background:#fff9f3}
.ftabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.ftab{padding:8px 16px;border-radius:100px;border:1.5px solid var(--border2);background:#fff;font-size:12px;font-weight:700;color:var(--warm);cursor:pointer;transition:all .2s;font-family:'Outfit',sans-serif;letter-spacing:.02em}
.ftab:hover,.ftab.active{border-color:var(--saffron);background:var(--saffron);color:#fff}
.egrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:22px}

/* Event card */
.ecard{background:#fff;border-radius:var(--r2);overflow:hidden;border:1px solid var(--border);transition:all .25s;cursor:pointer}
.ecard:hover{transform:translateY(-6px);box-shadow:var(--sh-lift);border-color:transparent}
.ecard-img{height:206px;position:relative;overflow:hidden}
.ecard-img img{height:100%;transition:transform .5s}
.ecard:hover .ecard-img img{transform:scale(1.06)}
.ecard-badge{position:absolute;top:12px;left:12px;display:flex;align-items:center;gap:5px;background:rgba(255,255,255,.95);border-radius:8px;padding:5px 10px;font-size:11px;font-weight:700}
.badge-live{width:6px;height:6px;border-radius:50%;background:#22c55e;animation:pulse 1.5s infinite}
.ecard-save{position:absolute;top:12px;right:12px;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;font-size:15px;border:none;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(0,0,0,.1)}
.ecard-save:hover{transform:scale(1.15)}
.ecard-body{padding:18px 18px 16px}
.ecard-cat{font-size:10px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--saffron);margin-bottom:5px}
.ecard-title{font-family:'Cormorant Garamond',serif;font-size:19px;font-weight:700;color:var(--ink);line-height:1.25;margin-bottom:10px}
.ecard-meta{display:flex;flex-direction:column;gap:5px;margin-bottom:14px}
.ecard-mi{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--warm)}
.ecard-mi svg{width:13px;height:13px;flex-shrink:0;color:var(--saffron)}
.ecard-foot{display:flex;align-items:center;justify-content:space-between;padding-top:12px;border-top:1px solid var(--border)}
.ecard-price{font-family:'Cormorant Garamond',serif}
.price-free{font-size:17px;font-weight:700;color:var(--teal)}
.price-amt{font-size:20px;font-weight:700;color:var(--ink)}
.price-lbl{font-size:11px;color:var(--warm);font-family:'Outfit',sans-serif}
.book-btn{background:var(--saffron);color:#fff;border:none;border-radius:10px;padding:8px 16px;font-size:12px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;transition:all .2s}
.book-btn:hover{background:#d95300}

/* ── FEATURED BANNER ── */
.feat-section{background:var(--cream)}
.feat-grid{display:grid;grid-template-columns:1fr 1fr;border-radius:var(--r2);overflow:hidden;min-height:480px}
.feat-img{position:relative;overflow:hidden}
.feat-img img{height:100%;object-fit:cover;transition:transform .6s}
.feat-grid:hover .feat-img img{transform:scale(1.04)}
.feat-img::after{content:'';position:absolute;inset:0;background:linear-gradient(to right,transparent 40%,rgba(22,16,10,.9) 100%)}
.feat-content{background:var(--ink);padding:52px 48px;display:flex;flex-direction:column;justify-content:center}
.feat-eyebrow{display:flex;align-items:center;gap:8px;color:var(--gold2);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:16px}
.feat-title{font-family:'Cormorant Garamond',serif;font-size:36px;font-weight:700;color:#fff;line-height:1.15;margin-bottom:14px}
.feat-desc{color:rgba(255,255,255,.62);font-size:14px;line-height:1.7;margin-bottom:24px}
.feat-pills{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:28px}
.feat-pill{display:flex;align-items:center;gap:6px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:100px;padding:6px 14px;font-size:12px;color:rgba(255,255,255,.75)}
.feat-pill svg{width:13px;height:13px;color:var(--gold2)}
.feat-actions{display:flex;gap:12px}

/* ── CITIES ── */
.cities-section{background:#fff9f3}
.cities-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:14px;margin-top:32px}
.city-card{border-radius:var(--r2);overflow:hidden;height:180px;position:relative;cursor:pointer;transition:all .25s}
.city-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lift)}
.city-card img{height:100%;object-fit:cover;transition:transform .5s}
.city-card:hover img{transform:scale(1.08)}
.city-card::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(22,16,10,.75) 0%,rgba(22,16,10,.15) 55%)}
.city-body{position:absolute;bottom:0;left:0;right:0;padding:14px 16px;color:#fff}
.city-name{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:700}
.city-count{font-size:11px;opacity:.75;margin-top:1px}

/* ── HOW ── */
.how-section{background:#fff}
.how-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:28px;margin-top:44px}
.how-card{background:var(--cream);border-radius:var(--r2);padding:28px 24px;text-align:center;border:1px solid var(--border)}
.how-n{width:50px;height:50px;border-radius:50%;background:var(--saffron-pale);color:var(--saffron);font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:700;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;border:2px solid rgba(255,98,0,.18)}
.how-img{width:56px;height:56px;border-radius:14px;object-fit:cover;margin:0 auto 14px}
.how-title{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:700;margin-bottom:7px}
.how-desc{font-size:13px;color:var(--warm);line-height:1.65}

/* ── TESTIMONIALS ── */
.testi-section{background:var(--ink)}
.testi-section .slabel{color:var(--gold2)}
.testi-section .stitle{color:#fff}
.tgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:20px;margin-top:40px}
.tcard{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:var(--r2);padding:26px;transition:all .2s}
.tcard:hover{background:rgba(255,255,255,.1);border-color:rgba(245,166,35,.3)}
.t-stars{color:var(--gold);font-size:17px;letter-spacing:2px;margin-bottom:13px}
.t-text{color:rgba(255,255,255,.75);font-size:14px;font-style:italic;line-height:1.7;margin-bottom:18px}
.t-author{display:flex;align-items:center;gap:11px}
.t-ava{width:38px;height:38px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,.2)}
.t-name{font-weight:600;font-size:13px;color:#fff}
.t-city{font-size:11px;color:rgba(255,255,255,.45)}

/* ── NEWSLETTER ── */
.nl-section{background:var(--cream)}
.nl-inner{max-width:580px;margin:0 auto;text-align:center}
.nl-img{width:80px;height:80px;border-radius:50%;object-fit:cover;margin:0 auto 18px;border:3px solid var(--saffron)}
.nl-form{display:flex;gap:10px;margin-top:24px}
.nl-input{flex:1;padding:13px 18px;border:1.5px solid var(--border2);border-radius:14px;font-family:'Outfit',sans-serif;font-size:14px;outline:none;transition:border-color .2s;background:#fff}
.nl-input:focus{border-color:var(--saffron)}

/* ── CTA ── */
.cta-section{background:var(--cream)}
.cta-inner{background:linear-gradient(130deg,var(--saffron) 0%,#d95300 45%,var(--rose) 100%);border-radius:28px;padding:60px 48px;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:center;overflow:hidden;position:relative}
.cta-inner::before{content:'';position:absolute;right:-60px;top:-60px;width:300px;height:300px;border-radius:50%;background:rgba(255,255,255,.07);pointer-events:none}
.cta-inner::after{content:'';position:absolute;right:160px;bottom:-80px;width:200px;height:200px;border-radius:50%;background:rgba(255,255,255,.05);pointer-events:none}
.cta-title{font-family:'Cormorant Garamond',serif;font-size:clamp(24px,3vw,36px);font-weight:700;color:#fff;line-height:1.2;margin-bottom:10px}
.cta-desc{color:rgba(255,255,255,.78);font-size:15px}
.cta-btns{display:flex;gap:12px;flex-direction:column}
.btn-white{background:#fff;color:var(--saffron);font-weight:700;font-size:14px;padding:12px 24px;border-radius:100px;border:none;cursor:pointer;font-family:'Outfit',sans-serif;transition:all .2s;white-space:nowrap;display:inline-flex;align-items:center}
.btn-white:hover{background:var(--saffron-pale);transform:translateY(-1px)}
.btn-outline-w{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.42);font-weight:600;font-size:14px;padding:12px 24px;border-radius:100px;cursor:pointer;font-family:'Outfit',sans-serif;transition:all .2s;white-space:nowrap}
.btn-outline-w:hover{background:rgba(255,255,255,.12)}

/* ── FOOTER ── */
footer{background:var(--ink);color:rgba(255,255,255,.6);padding:56px 4% 28px}
.footer-inner{max-width:1280px;margin:0 auto}
.fg{display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:44px;margin-bottom:44px}
.f-brand-desc{font-size:13px;line-height:1.75;margin:12px 0 18px;max-width:240px}
.f-social{display:flex;gap:9px}
.f-sc{width:34px;height:34px;border-radius:9px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;cursor:pointer;transition:all .2s}
.f-sc:hover{background:var(--saffron);border-color:var(--saffron)}
.f-h{color:#fff;font-weight:700;font-size:13px;letter-spacing:.04em;margin-bottom:16px;text-transform:uppercase}
.f-links{list-style:none}
.f-links li{margin-bottom:9px}
.f-links a{color:rgba(255,255,255,.5);font-size:13px;transition:color .2s}
.f-links a:hover{color:var(--saffron2)}
.f-bottom{border-top:1px solid rgba(255,255,255,.09);padding-top:22px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:12px}
.f-logo{font-family:'Cormorant Garamond',serif;font-weight:700;font-size:20px;color:#fff}
.f-logo span{color:var(--saffron)}

/* ── MODAL ── */
.modal-ov{position:fixed;inset:0;z-index:9999;background:rgba(22,16,10,.65);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;pointer-events:none;transition:opacity .3s}
.modal-ov.open{opacity:1;pointer-events:all}
.modal{background:#fff;border-radius:24px;width:100%;max-width:500px;max-height:90vh;overflow-y:auto;transform:translateY(28px);transition:transform .3s}
.modal-ov.open .modal{transform:translateY(0)}
.m-head{padding:22px 22px 0;display:flex;justify-content:space-between;align-items:flex-start}
.m-title{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:700}
.m-close{width:30px;height:30px;border-radius:50%;background:#f3f0eb;border:none;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;transition:all .2s}
.m-close:hover{background:var(--saffron);color:#fff}
.m-body{padding:18px 22px 26px}
