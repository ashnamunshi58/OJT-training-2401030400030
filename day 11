  {id:22,img:'https://images.unsplash.com/photo-1551698618-1dfe5d97d256?w=600&q=80',title:'Himalayan Trail Run',cat:'sports',category:'Sports',date:'Aug 15',time:'5:00 AM',city:'Manali',location:'Solang Valley, Manali',price:3500,tag:'Adventure',tc:'#0A7E8C',saved:false,filters:['all','outdoor']},
];

let visibleCount=12;
let currentData=[...EVENTS];
let modalState={price:0,qty:1};

// RENDER EVENTS
function renderEvents(data){
  const grid=$('#egrid');grid.empty();
  const slice=data.slice(0,visibleCount);
  if(!slice.length){
    grid.html('<p style="color:var(--warm);text-align:center;padding:40px 0;grid-column:1/-1;font-size:15px">No events found. Try different filters!</p>');
    return;
  }
  slice.forEach((e,i)=>{
    const priceHtml=e.price===0
      ?`<span class="price-free">Free</span>`
      :`<span class="price-amt">₹${e.price.toLocaleString('en-IN')}</span><span class="price-lbl"> onwards</span>`;
    const card=$(`
    <div class="ecard fu" style="transition-delay:${(i%4)*0.06}s" data-id="${e.id}">
      <div class="ecard-img">
        <img src="${e.img}" alt="${e.title}" loading="lazy">
        <div class="ecard-badge"><div class="badge-live" style="background:${e.tc}"></div>${e.tag}</div>
        <button class="ecard-save ${e.saved?'saved':''}" data-id="${e.id}">${e.saved?'❤️':'🤍'}</button>
      </div>
      <div class="ecard-body">
        <div class="ecard-cat">${e.category}</div>
        <div class="ecard-title">${e.title}</div>
        <div class="ecard-meta">
          <div class="ecard-mi">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            ${e.date} · ${e.time}
          </div>
          <div class="ecard-mi">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            ${e.location}
          </div>
        </div>
        <div class="ecard-foot">
          <div class="ecard-price">${priceHtml}</div>
          <button class="book-btn" data-id="${e.id}">Book Now</button>
        </div>
      </div>
    </div>`);
    grid.append(card);
  });
  setTimeout(()=>{$('.fu').addClass('vis')},60);
  $('#load-more').toggle(data.length>visibleCount);
}

// CATEGORY pills
$('#catrow').on('click','.cat-pill',function(e){
  e.preventDefault();
  $('.cat-pill').removeClass('active');$(this).addClass('active');
  const cat=$(this).data('cat');
  visibleCount=12;
  currentData=cat==='all'?[...EVENTS]:EVENTS.filter(ev=>ev.cat===cat);
  renderEvents(currentData);
});

// FILTER TABS
$('#ftabs').on('click','.ftab',function(){
  $('.ftab').removeClass('active');$(this).addClass('active');
  const f=$(this).data('f');
  visibleCount=12;
  currentData=f==='all'?[...EVENTS]:EVENTS.filter(e=>e.filters.includes(f));
  renderEvents(currentData);
});

// LOAD MORE
$('#load-more').on('click',function(){
  visibleCount+=6;
  renderEvents(currentData);
});

// SEARCH
function doSearch(){
  const q=$('#q').val().toLowerCase().trim();
  const city=$('#city').val().toLowerCase();
  const catsel=$('#catsel').val().toLowerCase();
  visibleCount=12;
  currentData=EVENTS.filter(e=>{
    const mq=!q||(e.title.toLowerCase().includes(q)||e.category.toLowerCase().includes(q)||e.location.toLowerCase().includes(q));
    const mc=!city||e.city.toLowerCase().includes(city);
    const ms=!catsel||e.category.toLowerCase().includes(catsel);
    return mq&&mc&&ms;
  });
  renderEvents(currentData);
  $('html,body').animate({scrollTop:$('#events').offset().top-80},450);
  showToast(currentData.length?`Found ${currentData.length} events 🎉`:'No events matched your search.','🔍');
}
$('#q').on('keydown',function(e){if(e.key==='Enter')doSearch()});

// SAVE
$(document).on('click','.ecard-save',function(e){
  e.stopPropagation();
  const id=parseInt($(this).data('id'));
  const ev=EVENTS.find(x=>x.id===id);
  ev.saved=!ev.saved;
  $(this).html(ev.saved?'❤️':'🤍').toggleClass('saved',ev.saved);
  showToast(ev.saved?`Saved "${ev.title}"! 💛`:'Removed from saved.','💛');
});

// BOOK
$(document).on('click','.book-btn',function(){
  const id=parseInt($(this).data('id'));
  const ev=EVENTS.find(x=>x.id===id);
  openModal({title:ev.title,date:ev.date,img:ev.img,price:ev.price});
});

// MODAL
function openModal(ev){
  modalState={price:ev.price,qty:1};
  $('#m-ev-title').text(ev.title);
  $('#m-ev-date').text('📅 '+ev.date);
  $('#m-ev-img').attr('src',ev.img).attr('alt',ev.title);
  $('#qty-n').text(1);
  const types=ev.price===0
    ?[{n:'General',d:'Full event access',p:0},{n:'VIP Pass',d:'Premium areas + goodies',p:599}]
    :[{n:'General',d:'Standard access',p:ev.price},{n:'Premium',d:'Reserved seating',p:Math.round(ev.price*1.6)},{n:'VIP',d:'All-access + backstage',p:Math.round(ev.price*2.8)}];
  const g=$('#m-tgrid').empty();
  types.forEach((t,i)=>{
    g.append(`<div class="m-ttype${i===0?' selected':''}" data-price="${t.p}" onclick="selType(this)">
      <div><div class="m-tname">${t.n}</div><div class="m-tdesc">${t.d}</div></div>
      <div class="m-tprice">${t.p===0?'Free':'₹'+t.p.toLocaleString('en-IN')}</div>
    </div>`);
  });
  modalState.price=types[0].p;
  updateTotal();
  $('#mov').addClass('open');
  $('body').css('overflow','hidden');
}
function selType(el){
  $('.m-ttype').removeClass('selected');$(el).addClass('selected');
  modalState.price=parseInt($(el).data('price'));
  modalState.qty=1;$('#qty-n').text(1);
  updateTotal();
}
function qtyChange(d){
  modalState.qty=Math.max(1,Math.min(10,modalState.qty+d));
  $('#qty-n').text(modalState.qty);updateTotal();
}
function updateTotal(){
  const t=modalState.price*modalState.qty;
  $('#m-total').text(t===0?'Free':'₹'+t.toLocaleString('en-IN'));
}
function closeMod(e,force){
  if(force||(e&&$(e.target).is('#mov'))){
    $('#mov').removeClass('open');$('body').css('overflow','');
  }
}
function confirmBook(){
  const t=modalState.price*modalState.qty;
  closeMod(null,true);
  showToast(t===0?'Booking confirmed! Check email for ticket. 🎉':`₹${t.toLocaleString('en-IN')} paid! E-tickets sent to your email. 🎟️`,'🎊');
}

// NEWSLETTER
function nlsub(){
  const e=$('#nlemail').val().trim();
  if(!e||!e.includes('@')){showToast('Please enter a valid email.','⚠️');return;}
  showToast('You\'re subscribed! Welcome to Festiva. 🎊','✉️');
  $('#nlemail').val('');
}

// TOAST
function showToast(msg,icon='✅'){
  $('#t-msg').text(msg);$('#t-icon').text(icon);
  $('#toast').addClass('show');
  clearTimeout(window._tt);
  window._tt=setTimeout(()=>$('#toast').removeClass('show'),3600);
}

// SCROLL & FADE
$(window).on('scroll',function(){
  $('#nav').toggleClass('scrolled',$(this).scrollTop()>20);
  $('.fu:not(.vis)').each(function(){
    if(this.getBoundingClientRect().top<window.innerHeight-60)$(this).addClass('vis');
  });
});

// HAMBURGER
$('#hbg').on('click',()=>$('#mobnav').toggleClass('open'));

// INIT
$(function(){
  const today=new Date().toISOString().split('T')[0];
  $('[type=date]').val(today);
  renderEvents(currentData);
  setTimeout(()=>$('.fu').each(function(){
    if(this.getBoundingClientRect().top<window.innerHeight+100)$(this).addClass('vis');
  }),100);
});
</script>
