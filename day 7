<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Luxury Watches</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Remix Icons -->
  <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet">

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>

    body{
      background:#f5f5f5;
      font-family:'Poppins',sans-serif;
    }

    /* TOP BAR */

    .top-bar{
      background:#0f0f0f;
      border-bottom:1px solid #222;
      padding:15px 0;
    }

    .top-bar a{
      text-decoration:none;
      color:#fff;
      transition:0.3s;
      font-size:18px;
    }

    .top-bar a:hover{
      color:#d4af37;
    }

    .logo{
      color:#d4af37;
      font-size:35px;
      font-family:'Cinzel',serif;
      letter-spacing:3px;
      font-weight:700;
    }

    .top-icons i{
      font-size:24px;
      color:#fff;
      cursor:pointer;
      transition:0.3s;
    }

    .top-icons i:hover{
      color:#d4af37;
    }

    .cart-icon{
      position:relative;
    }

    #cart-count{
      position:absolute;
      top:-8px;
      right:-10px;
      background:#d4af37;
      color:#fff;
      width:20px;
      height:20px;
      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:12px;
      font-weight:bold;
    }

    /* NAVBAR */

    .navbar-custom{
      background:#fff;
      border-bottom:1px solid #ddd;
    }

    .navbar-nav .nav-link{
      color:#111;
      font-size:17px;
      font-family:'Cinzel',serif;
      transition:0.3s;
    }

    .navbar-nav .nav-link:hover{
      color:#c79a3b;
    }

    .search-box{
      position:relative;
    }

    .search-box input{
      border-radius:30px;
      padding-right:45px;
    }

    .search-box i{
      position:absolute;
      right:15px;
      top:50%;
      transform:translateY(-50%);
      cursor:pointer;
    }

    /* SLIDER */

    .carousel-item img{
      height:500px;
      object-fit:cover;
    }

    /* HEADER */

    .arrival-title{
      background:#000d11;
      color:#fff;
      font-family:'Cinzel',serif;
      padding:15px;
      border:2px solid #fff;
    }

    .arrival-subtitle{
      background:#eee;
      color:#c79a3b;
      padding:10px;
      font-size:20px;
      font-family:'Cinzel',serif;
    }

    /* BRANDS */

    .brands{
      background:#111;
      padding:70px 0;
    }

    .brand-name{
      color:#fff;
      font-size:35px;
      font-family:'Cinzel',serif;
      transition:0.3s;
      cursor:pointer;
    }

    .brand-name:hover{
      color:#d4af37;
      transform:scale(1.1);
    }

    /* PRODUCTS */

    .product-card{
      border:none;
      border-radius:12px;
      overflow:hidden;
      transition:0.3s;
      box-shadow:0 5px 15px rgba(0,0,0,0.1);
    }

    .product-card:hover{
      transform:translateY(-10px);
    }

    .product-card img{
      height:250px;
      object-fit:cover;
    }

    .product-card .card-title{
      font-size:24px;
      color:#111;
    }

    .price{
      color:#c79a3b;
      font-size:22px;
      font-weight:600;
    }

    .btn-dark-custom{
      background:#111;
      color:#fff;
      border:none;
    }

    .btn-dark-custom:hover{
      background:#c79a3b;
      color:#fff;
    }

  </style>
</head>

<body>

  <!-- TOP BAR -->

  <div class="top-bar">
    <div class="container">
      <div class="row align-items-center">

        <div class="col-md-4 d-flex gap-4">
          <a href="#"><i class="ri-map-pin-line"></i> Stores</a>
          <a href="#"><i class="ri-phone-line"></i> Contact Us</a>
        </div>

        <div class="col-md-4 text-center">
          <div class="logo">Luxury Watches</div>
        </div>

        <div class="col-md-4">
          <div class="top-icons d-flex justify-content-end align-items-center gap-4">

            <i class="ri-user-line" data-bs-toggle="modal" data-bs-target="#loginModal"></i>

            <i class="ri-heart-line"></i>

            <div class="cart-icon">
              <i class="ri-shopping-bag-line"></i>
              <span id="cart-count">0</span>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- NAVBAR -->

  <nav class="navbar navbar-expand-lg navbar-custom py-3">
    <div class="container">

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarContent">

        <ul class="navbar-nav mx-auto gap-lg-4">
          <li class="nav-item"><a class="nav-link" href="#">All Watches</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Men</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Women</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Smart</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Brands</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Offers</a></li>
        </ul>

        <div class="search-box">
          <input type="text" class="form-control" placeholder="Search watches...">
          <i class="ri-search-line"></i>
        </div>

      </div>
    </div>
  </nav>

  <!-- SLIDER -->

  <div id="watchSlider" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-inner">

      <div class="carousel-item active">
        <img src="https://i.pinimg.com/736x/1b/20/75/1b20752a3e8b29d1e20190d598f956c4.jpg"
          class="d-block w-100" alt="slider">
      </div>

      <div class="carousel-item">
        <img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?q=80&w=1200"
          class="d-block w-100" alt="slider">
      </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#watchSlider" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#watchSlider" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
    </button>

  </div>

  <!-- NEW ARRIVALS -->

  <section class="py-5 text-center">

    <div class="container">

      <h1 class="arrival-title">NEW ARRIVALS</h1>

      <p class="arrival-subtitle">
        Premium watches for modern lifestyle
      </p>

    </div>

  </section>

  <!-- BRANDS -->

  <section class="brands">

    <div class="container">

      <div class="row text-center g-4">

        <div class="col-md-2 col-6">
          <div class="brand-name">ROLEX</div>
        </div>

        <div class="col-md-2 col-6">
          <div class="brand-name">OMEGA</div>
        </div>

        <div class="col-md-2 col-6">
          <div class="brand-name">FOSSIL</div>
        </div>

        <div class="col-md-2 col-6">
          <div class="brand-name">TITAN</div>
        </div>

        <div class="col-md-2 col-6">
          <div class="brand-name">CASIO</div>
        </div>

      </div>

    </div>

  </section>

  <!-- PRODUCTS -->

  <section class="py-5 bg-white">

    <div class="container">

      <div class="row g-4">

        <!-- PRODUCT 1 -->

        <div class="col-lg-3 col-md-6">

          <div class="card product-card h-100">

            <img src="https://images.unsplash.com/photo-1546868871-7041f2a55e12?q=80&w=800"
              class="card-img-top" alt="watch">

            <div class="card-body text-center">

              <h5 class="card-title">Titan Smart Pro</h5>

              <p class="price">₹18,999</p>

              <button class="btn btn-dark-custom w-100 mb-2"
                onclick="addToCart('Titan Smart Pro',18999)">
                Add To Cart
              </button>

              <button class="btn btn-warning w-100"
                onclick="buyNow('Titan Smart Pro',18999)">
                Buy Now
              </button>

            </div>
          </div>
        </div>

        <!-- PRODUCT 2 -->

        <div class="col-lg-3 col-md-6">

          <div class="card product-card h-100">

            <img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?q=80&w=800"
              class="card-img-top" alt="watch">

            <div class="card-body text-center">

              <h5 class="card-title">Omega Classic</h5>

              <p class="price">₹38,000</p>

              <button class="btn btn-dark-custom w-100 mb-2"
                onclick="addToCart('Omega Classic',38000)">
                Add To Cart
              </button>

              <button class="btn btn-warning w-100"
                onclick="buyNow('Omega Classic',38000)">
                Buy Now
              </button>

            </div>
          </div>
        </div>

        <!-- PRODUCT 3 -->

        <div class="col-lg-3 col-md-6">

          <div class="card product-card h-100">

            <img src="https://images.unsplash.com/photo-1542496658-e33a6d0d50f6?q=80&w=800"
              class="card-img-top" alt="watch">

            <div class="card-body text-center">

              <h5 class="card-title">Fossil Watch</h5>

              <p class="price">₹18,000</p>

              <button class="btn btn-dark-custom w-100 mb-2"
                onclick="addToCart('Fossil Watch',18000)">
                Add To Cart
              </button>

              <button class="btn btn-warning w-100"
                onclick="buyNow('Fossil Watch',18000)">
                Buy Now
              </button>

            </div>
          </div>
        </div>

        <!-- PRODUCT 4 -->

        <div class="col-lg-3 col-md-6">

          <div class="card product-card h-100">

            <img src="https://images.unsplash.com/photo-1522312346375-d1a52e2b99b3?q=80&w=800"
              class="card-img-top" alt="watch">

            <div class="card-body text-center">

              <h5 class="card-title">Tissot</h5>

              <p class="price">₹47,000</p>

              <button class="btn btn-dark-custom w-100 mb-2"
                onclick="addToCart('Tissot',47000)">
                Add To Cart
              </button>

              <button class="btn btn-warning w-100"
                onclick="buyNow('Tissot',47000)">
                Buy Now
              </button>

            </div>
          </div>
        </div>

      </div>

    </div>

  </section>

  <!-- LOGIN MODAL -->

  <div class="modal fade" id="loginModal" tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

      <div class="modal-content p-3">

        <div class="modal-header border-0">
          <h5 class="modal-title">Login</h5>

          <button type="button" class="btn-close"
            data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">

          <form>

            <div class="mb-3">
              <input type="email" class="form-control"
                placeholder="Enter Email">
            </div>

            <div class="mb-3">
              <input type="password" class="form-control"
                placeholder="Enter Password">
            </div>

            <button type="submit"
              class="btn btn-dark w-100">
              Login
            </button>

          </form>

        </div>

      </div>

    </div>

  </div>

  <!-- Bootstrap JS -->

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>

    let cartCount = 0;

    function addToCart(name, price){

      cartCount++;

      document.getElementById("cart-count").innerText = cartCount;

      alert(name + " added to cart!");
    }

    function buyNow(name, price){

      alert("Proceeding to buy " + name + " for ₹" + price);
    }

  </script>

</body>
</html>
