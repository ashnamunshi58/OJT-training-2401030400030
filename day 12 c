  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6">
        <h2 class="logo">Luxury Watches</h2>
        <p class="text-secondary">Luxury watches crafted for timeless elegance.</p>
      </div>
      <div class="col-md-6 text-md-end mt-4 mt-md-0">
        <a href="#" class="text-warning me-3 fs-3"><i class="ri-instagram-fill"></i></a>
        <a href="#" class="text-warning me-3 fs-3"><i class="ri-twitter-x-fill"></i></a>
        <a href="#" class="text-warning fs-3"><i class="ri-youtube-fill"></i></a>
      </div>
    </div>
    <hr class="border-secondary">
    <div class="text-center text-secondary">© 2026 Luxury Watches. All rights reserved.</div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script>

// ===================== DATA =====================
const allWatches = [
  { id:1, name:"Titan Smart Pro", price:18999, priceStr:"₹18,999", img:"https://images.unsplash.com/photo-1546868871-7041f2a55e12?q=80&w=800", category:["smart","titan","all"], offer:true },
  { id:2, name:"Omega Classic", price:38000, priceStr:"₹38,000", img:"https://images.unsplash.com/photo-1523170335258-f5ed11844a49?q=80&w=800", category:["men","omega","all"], offer:false },
  { id:3, name:"Fossil Watch", price:18000, priceStr:"₹18,000", img:"https://images.unsplash.com/photo-1542496658-e33a6d0d50f6?q=80&w=800", category:["men","fossil","all"], offer:true },
  { id:4, name:"Tissot", price:47000, priceStr:"₹47,000", img:"https://images.unsplash.com/photo-1522312346375-d1a52e2b99b3?q=80&w=800", category:["men","tissot","all"], offer:false },
  { id:5, name:"Rado Classic", price:87000, priceStr:"₹87,000", img:"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTPQzclv6GdU5hB2vMXGdkWZyLgsQtS9v3YeA&s", category:["men","all"], offer:false },
  { id:6, name:"Apple Watch Ultra", price:55000, priceStr:"₹55,000", img:"https://images.unsplash.com/photo-1551816230-ef5deaed4a26?q=80&w=800", category:["smart","all"], offer:true },
  { id:7, name:"Titan Neo", price:55000, priceStr:"₹55,000", img:"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRqZV1KZ7v-zEvQrMfJ2MaQvOsVHtmnIrNa5Y49SuSUmA&s", category:["men","titan","all"], offer:false },
  { id:8, name:"Kenneth Cole", price:32000, priceStr:"₹32,000", img:"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQus7rHr6xrJF2a_HxSxPfGnBZ0PmNKEW0IQw&s", category:["men","all"], offer:false },
  { id:9, name:"Casio G-Shock", price:8500, priceStr:"₹8,500", img:"https://images.unsplash.com/photo-1524592094714-0f0654e20314?q=80&w=800", category:["men","casio","all"], offer:true },
  { id:10, name:"Rolex Submariner", price:890000, priceStr:"₹8,90,000", img:"https://images.unsplash.com/photo-1547996160-81dfa63595aa?q=80&w=800", category:["men","rolex","all"], offer:false },
  { id:11, name:"Titan Raga (Women)", price:12500, priceStr:"₹12,500", img:"https://images.unsplash.com/photo-1508057198894-247b23fe5ade?q=80&w=800", category:["women","titan","all"], offer:true },
  { id:12, name:"Fossil Women's Rose Gold", price:15000, priceStr:"₹15,000", img:"https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=800", category:["women","fossil","all"], offer:false },
  { id:13, name:"Samsung Galaxy Watch", price:27000, priceStr:"₹27,000", img:"https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?q=80&w=800", category:["smart","all"], offer:false },
  { id:14, name:"Omega Seamaster (Women)", price:62000, priceStr:"₹62,000", img:"https://images.unsplash.com/photo-1434056886845-dac89ffe9b56?q=80&w=800", category:["women","omega","all"], offer:false },
  { id:15, name:"Casio Vintage (Women)", price:5500, priceStr:"₹5,500", img:"https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?q=80&w=800", category:["women","casio","all"], offer:true },
  { id:16, name:"Garmin Fenix", price:45000, priceStr:"₹45,000", img:"https://images.unsplash.com/photo-1575311373937-040b8e1fd5b6?q=80&w=800", category:["smart","all"], offer:false },
];

// ===================== STATE =====================
let cart = [];
let wishlist = [];
let currentFilter = 'all';
let visibleCount = 8;
let currentPage = 'home';

// ===================== PAGES =====================
function showPage(page) {
  document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
  const el = document.getElementById('page-' + page);
  if (el) el.classList.add('active');
  currentPage = page;

  if (page === 'cart') renderCart();
  if (page === 'wishlist') renderWishlist();
  if (page === 'offers-page') renderOffers();
  if (page !== 'home' && page !== 'brands-page' && page !== 'offers-page') {
    showPage('home');
    return;
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ===================== FILTERING =====================
function filterWatches(filter) {
  currentFilter = filter;
  visibleCount = 8;
  showPage('home');

  // update nav highlight
  document.querySelectorAll('.navbar-nav .nav-link').forEach(l => l.classList.remove('active-nav'));
  const navMap = { all: 'nav-all', men: 'nav-men', women: 'nav-women', smart: 'nav-smart' };
  if (navMap[filter]) document.getElementById(navMap[filter]).classList.add('active-nav');

  // update section titles
  const titles = {
    all: ['NEW ARRIVALS', 'Premium watches for modern lifestyle'],
    men: ["MEN'S COLLECTION", 'Bold precision for the modern man'],
    women: ["WOMEN'S COLLECTION", 'Elegance and grace for every occasion'],
    smart: ['SMART WATCHES', 'Technology meets luxury'],
    rolex: ['ROLEX', 'Swiss precision. Timeless luxury.'],
    omega: ['OMEGA', 'The choice of astronauts and legends.'],
    fossil: ['FOSSIL', 'Modern style, vintage soul.'],
    titan: ['TITAN', "India's most loved watchmaker."],
    casio: ['CASIO', 'Precision engineering since 1946.'],
    tissot: ['TISSOT', 'Innovators by tradition.'],
  };
  const [t, s] = titles[filter] || ['WATCHES', ''];
  document.getElementById('sectionTitle').textContent = t;
  document.getElementById('sectionSubtitle').textContent = s;
  document.getElementById('searchInput').value = '';

  renderGrid();
}

function searchWatches() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const filtered = allWatches.filter(w => w.name.toLowerCase().includes(q));
  renderGridWith(filtered);
}

function renderGrid() {
  const filtered = allWatches.filter(w => w.category.includes(currentFilter));
  renderGridWith(filtered.slice(0, visibleCount), filtered.length > visibleCount);
}

function renderGridWith(watches, showMore = false) {
  const grid = document.getElementById('productGrid');
  grid.innerHTML = watches.length ? watches.map(w => cardHTML(w)).join('') : '<div class="col-12 text-center text-muted py-5"><i class="ri-search-line" style="font-size:50px"></i><h5 class="mt-3">No watches found</h5></div>';
  document.getElementById('viewMoreContainer').style.display = showMore ? 'block' : 'none';
  updateWishlistButtons();
}

function loadMore() {
  visibleCount += 4;
  renderGrid();
}

// ===================== CARD HTML =====================
function cardHTML(w) {
  const inWish = wishlist.some(x => x.id === w.id);
  return `
  <div class="col-lg-3 col-md-6">
    <div class="card product-card shadow-sm h-100">
      <img src="${w.img}" class="card-img-top" onerror="this.src='https://images.unsplash.com/photo-1526045431048-f857369baa09?q=80&w=800'">
      ${w.offer ? '<span class="badge-tag">OFFER</span>' : ''}
      <div class="wishlist-btn ${inWish ? 'active' : ''}" onclick="toggleWishlist(this,${w.id})" data-id="${w.id}">
        <i class="${inWish ? 'ri-heart-fill' : 'ri-heart-line'}"></i>
      </div>
      <div class="card-body text-center">
        <h5>${w.name}</h5>
        <p class="price">${w.priceStr}</p>
        <button class="btn btn-dark btn-sm me-2" onclick="addToCart(${w.id})">Add To Cart</button>
        <button class="btn btn-warning btn-sm" onclick="openPayment(${w.id})">Buy Now</button>
      </div>
    </div>
  </div>`;
}

function updateWishlistButtons() {
  document.querySelectorAll('.wishlist-btn[data-id]').forEach(btn => {
    const id = parseInt(btn.dataset.id);
    const inWish = wishlist.some(x => x.id === id);
    btn.classList.toggle('active', inWish);
    const icon = btn.querySelector('i');
    icon.className = inWish ? 'ri-heart-fill' : 'ri-heart-line';
  });
}

// ===================== CART =====================
function addToCart(id) {
  const watch = allWatches.find(w => w.id === id);
  const existing = cart.find(x => x.id === id);
  if (existing) { existing.qty++; }
  else { cart.push({ ...watch, qty: 1 }); }
  updateCartCount();
  showToast(`${watch.name} added to cart!`, 'cart');
}

function removeFromCart(id) {
  cart = cart.filter(x => x.id !== id);
  updateCartCount();
  renderCart();
}

function changeQty(id, delta) {
  const item = cart.find(x => x.id === id);
  if (!item) return;
  item.qty += delta;
  if (item.qty <= 0) removeFromCart(id);
  else renderCart();
  updateCartCount();
}

function updateCartCount() {
  const total = cart.reduce((s, x) => s + x.qty, 0);
  document.getElementById('cart-count').textContent = total;
}

function renderCart() {
  const el = document.getElementById('cartItems');
  if (!cart.length) {
    el.innerHTML = '<div class="empty-state"><i class="ri-shopping-bag-line"></i><h5>Your cart is empty</h5><p>Add some watches to get started!</p><button class="btn btn-dark mt-3" onclick="showPage(\'home\')">Shop Now</button></div>';
    document.getElementById('cartSubtotal').textContent = '₹0';
    document.getElementById('cartTotal').textContent = '₹0';
    return;
  }
  el.innerHTML = cart.map(item => `
    <div class="cart-item">
      <img src="${item.img}" onerror="this.src='https://images.unsplash.com/photo-1526045431048-f857369baa09?q=80&w=800'">
      <div class="cart-item-info">
        <h6 class="mb-1">${item.name}</h6>
        <p class="price mb-1" style="font-size:16px">${item.priceStr}</p>
        <div class="d-flex align-items-center gap-2 mt-2">
          <button class="qty-btn" onclick="changeQty(${item.id},-1)">−</button>
          <span class="qty-display">${item.qty}</span>
          <button class="qty-btn" onclick="changeQty(${item.id},1)">+</button>
        </div>
      </div>
      <div>
        <p class="fw-bold" style="color:var(--gold)">₹${(item.price * item.qty).toLocaleString('en-IN')}</p>
        <button class="remove-btn" onclick="removeFromCart(${item.id})"><i class="ri-delete-bin-line"></i></button>
      </div>
    </div>`).join('');
  const subtotal = cart.reduce((s, x) => s + x.price * x.qty, 0);
  document.getElementById('cartSubtotal').textContent = '₹' + subtotal.toLocaleString('en-IN');
  document.getElementById('cartTotal').textContent = '₹' + subtotal.toLocaleString('en-IN');
}

function openCartCheckout() {
  if (!cart.length) { alert('Your cart is empty!'); return; }
  const total = cart.reduce((s, x) => s + x.price * x.qty, 0);
  document.getElementById('productName').textContent = `${cart.length} item(s)`;
  document.getElementById('productPrice').textContent = '₹' + total.toLocaleString('en-IN');
  document.getElementById('totalPrice').textContent = '₹' + total.toLocaleString('en-IN');
  document.getElementById('productImage').src = cart[0].img;
  new bootstrap.Modal(document.getElementById('paymentModal')).show();
}

// ===================== WISHLIST =====================
function toggleWishlist(btn, id) {
  const watch = allWatches.find(w => w.id === id);
  const idx = wishlist.findIndex(x => x.id === id);
  if (idx >= 0) {
    wishlist.splice(idx, 1);
    showToast(`${watch.name} removed from wishlist`, 'wish');
  } else {
    wishlist.push(watch);
    showToast(`${watch.name} added to wishlist!`, 'wish');
  }
  updateWishlistCount();
  updateWishlistButtons();
  if (currentPage === 'wishlist') renderWishlist();
}

function removeFromWishlist(id) {
  wishlist = wishlist.filter(x => x.id !== id);
  updateWishlistCount();
  renderWishlist();
}

function updateWishlistCount() {
  document.getElementById('wishlist-count').textContent = wishlist.length;
}

function renderWishlist() {
  const el = document.getElementById('wishlistItems');
  if (!wishlist.length) {
    el.innerHTML = '<div class="col-12 empty-state"><i class="ri-heart-line"></i><h5>Your wishlist is empty</h5><p>Save watches you love!</p><button class="btn btn-dark mt-3" onclick="showPage(\'home\')">Explore Watches</button></div>';
    return;
  }
  el.innerHTML = wishlist.map(w => `
    <div class="col-lg-3 col-md-6">
      <div class="card product-card shadow-sm h-100">
        <img src="${w.img}" class="card-img-top" onerror="this.src='https://images.unsplash.com/photo-1526045431048-f857369baa09?q=80&w=800'">
        <div class="wishlist-btn active" onclick="removeFromWishlist(${w.id})">
          <i class="ri-heart-fill"></i>
        </div>
        <div class="card-body text-center">
          <h5>${w.name}</h5>
          <p class="price">${w.priceStr}</p>
          <button class="btn btn-dark btn-sm me-2" onclick="addToCart(${w.id})">Add To Cart</button>
          <button class="btn btn-warning btn-sm" onclick="openPayment(${w.id})">Buy Now</button>
        </div>
      </div>
    </div>`).join('');
}

// ===================== OFFERS GRID =====================
function renderOffers() {
  const offerWatches = allWatches.filter(w => w.offer);
  document.getElementById('offerGrid').innerHTML = offerWatches.map(w => cardHTML(w)).join('');
  updateWishlistButtons();
}

// ===================== PAYMENT =====================
function openPayment(id) {
  const w = allWatches.find(x => x.id === id);
  document.getElementById('productName').textContent = w.name;
  document.getElementById('productPrice').textContent = w.priceStr;
  document.getElementById('totalPrice').textContent = w.priceStr;
  document.getElementById('productImage').src = w.img;
  new bootstrap.Modal(document.getElementById('paymentModal')).show();
}

function paymentSuccess() {
  bootstrap.Modal.getInstance(document.getElementById('paymentModal')).hide();
  cart = [];
  updateCartCount();
  setTimeout(() => alert('✅ Payment Successful! Your order has been placed. Thank you for shopping with Luxury Watches!'), 300);
}

// ===================== AUTH =====================
function showSignup() { document.getElementById('loginForm').style.display='none'; document.getElementById('signupForm').style.display='block'; }
function showLogin() { document.getElementById('signupForm').style.display='none'; document.getElementById('loginForm').style.display='block'; }

function doLogin() {
  const email = document.getElementById('loginEmail').value.trim();
  const pass = document.getElementById('loginPass').value.trim();
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!email) { alert('Please enter email'); return; }
  if (!emailPattern.test(email)) { alert('Please enter valid email'); return; }
  if (!pass) { alert('Please enter password'); return; }
  if (pass.length < 6) { alert('Password must be at least 6 characters'); return; }
  bootstrap.Modal.getInstance(document.getElementById('authModal')).hide();
  alert('Login Successful! Welcome back.');
}

function doSignup() {
  const name = document.getElementById('signupName').value.trim();
  const email = document.getElementById('signupEmail').value.trim();
  const pass = document.getElementById('signupPass').value.trim();
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!name) { alert('Please enter full name'); return; }
  if (!email) { alert('Please enter email'); return; }
  if (!emailPattern.test(email)) { alert('Please enter valid email'); return; }
  if (!pass) { alert('Please create password'); return; }
  if (pass.length < 6) { alert('Password must be at least 6 characters'); return; }
  bootstrap.Modal.getInstance(document.getElementById('authModal')).hide();
  alert('Account Created Successfully! Welcome to Luxury Watches.');
}

// ===================== TOAST =====================
function showToast(msg, type) {
  const existing = document.getElementById('lw-toast');
  if (existing) existing.remove();
  const toast = document.createElement('div');
  toast.id = 'lw-toast';
  toast.style.cssText = `position:fixed;bottom:30px;right:30px;background:${type==='wish'?'#d4af37':'#111'};color:#fff;padding:12px 20px;border-radius:10px;z-index:9999;font-family:Poppins,sans-serif;box-shadow:0 4px 20px rgba(0,0,0,0.3);transition:opacity 0.5s;font-size:14px;`;
  toast.textContent = (type === 'wish' ? '❤️ ' : '🛒 ') + msg;
  document.body.appendChild(toast);
  setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 500); }, 2500);
}

// ===================== INIT =====================
filterWatches('all');
</script>
